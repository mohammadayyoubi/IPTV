<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_2xs"
        android:paddingBottom="@dimen/space_xs">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_logo_well_rounded">

            <ImageView
                android:id="@+id/channelLogoImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_channel_placeholder" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.IPTV.Subtitle"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/countryFlagImageView"
                    android:layout_width="20dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/surface_highest"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.IPTV.Flag" />

                <TextView
                    android:id="@+id/channelCategoryTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.IPTV.Caption" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editChannelButton"
            style="@style/Widget.IPTV.IconButton.Row"
            android:contentDescription="@string/edit"
            app:icon="@drawable/ic_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteChannelButton"
            style="@style/Widget.IPTV.IconButton.Row.Danger"
            android:contentDescription="@string/delete"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
