<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ── Video (16:9 in portrait, full screen in landscape; sized in code) ── -->
    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/player_bg">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shutter_background_color="@color/player_bg"
            app:show_buffering="always"
            app:use_controller="true" />

        <!-- Idle / error message over the video -->
        <LinearLayout
            android:id="@+id/player_message"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/player_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_lg"
            android:visibility="gone">

            <ImageView
                android:id="@+id/player_message_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_live_tv"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/player_message_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.IPTV.Subtitle" />

            <TextView
                android:id="@+id/player_message_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.IPTV.Caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_retry"
                style="@style/Widget.IPTV.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:minHeight="40dp"
                android:text="@string/retry"
                android:visibility="gone"
                app:icon="@drawable/ic_refresh" />
        </LinearLayout>

        <View
            android:id="@+id/player_top_scrim"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_player_scrim_top" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            style="@style/Widget.IPTV.IconButton.OnVideo"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_sm"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back" />

        <!-- Shown with the player controls, also in fullscreen -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_quality"
            style="@style/Widget.IPTV.IconButton.OnVideo"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_sm"
            android:contentDescription="@string/video_quality"
            android:tooltipText="@string/video_quality"
            app:icon="@drawable/ic_hd" />
    </FrameLayout>

    <!-- ── Details ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/details_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_logo_well_rounded">

                    <ImageView
                        android:id="@+id/image_channel_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_channel_placeholder" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView style="@style/IPTV.LiveBadge" />

                        <TextView
                            android:id="@+id/text_server_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:textAppearance="@style/TextAppearance.IPTV.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_channel_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.IPTV.Title"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                app:chipSpacingHorizontal="@dimen/space_xs">

                <com.google.android.material.chip.Chip
                    android:id="@+id/text_category_name"
                    style="@style/Widget.IPTV.Chip.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_category" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/text_country_name"
                    style="@style/Widget.IPTV.Chip.Meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipIcon="@drawable/ic_public" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_favorite"
                style="@style/Widget.IPTV.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/add_to_favorites"
                app:icon="@drawable/ic_favorite_border"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_quality_details"
                style="@style/Widget.IPTV.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/quality_auto"
                app:icon="@drawable/ic_hd"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <TextView
                style="@style/IPTV.SectionLabel"
                android:layout_marginTop="28dp"
                android:text="@string/servers" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/server_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/space_xs"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/text_no_servers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2xs"
                android:text="@string/player_no_servers"
                android:textAppearance="@style/TextAppearance.IPTV.Body"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
