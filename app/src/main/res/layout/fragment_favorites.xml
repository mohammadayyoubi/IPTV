<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/page_gutter">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favorites_eyebrow"
            android:textAppearance="@style/TextAppearance.IPTV.Overline"
            android:textColor="@color/accent" />

        <TextView
            android:id="@+id/favoritesUserPageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:text="@string/favorites_title"
            android:textAppearance="@style/TextAppearance.IPTV.Display" />
    </LinearLayout>

    <!-- Search -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.IPTV.SearchField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/page_gutter">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/FavoritesSearchEditText"
            style="@style/Widget.IPTV.SearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_channels" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/countText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.IPTV.Overline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_favorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_gutter"
            android:paddingTop="@dimen/space_2xs"
            android:paddingEnd="@dimen/page_gutter"
            android:paddingBottom="@dimen/space_lg" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
