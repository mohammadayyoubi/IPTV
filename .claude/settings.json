{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_strings.py\"",
            "timeout": 15,
            "statusMessage": "Checking English/Arabic strings"
          }
        ]
      }
    ]
  }
}
